rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: nega tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDevice(device) {
      return device is string && device in ['Windows Desktop', 'Android', 'Web'];
    }

    // Entity Validators
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'lastActiveDevice', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'lastActiveDevice', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1500))
        && isValidDevice(data.lastActiveDevice)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReaderPreferences(data, userId) {
      return data.keys().hasAll(['ownerId', 'appTheme', 'readerTheme', 'fontFamily', 'fontSize', 'lineHeight', 'pageWidth', 'textAlign', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'appTheme', 'readerTheme', 'fontFamily', 'fontSize', 'lineHeight', 'pageWidth', 'textAlign', 'readingMode', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.appTheme in ['light', 'dark']
        && data.readerTheme in ['light', 'sepia', 'night', 'oled']
        && data.fontFamily in ['source-serif', 'lora', 'jakarta', 'dyslexic', 'mono']
        && data.fontSize is number && data.fontSize >= 12 && data.fontSize <= 36
        && data.lineHeight is number && data.lineHeight >= 1.0 && data.lineHeight <= 2.6
        && data.pageWidth in ['narrow', 'medium', 'wide']
        && data.textAlign in ['left', 'justify']
        && (!('readingMode' in data) || data.readingMode in ['paginated', 'scroll'])
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, userId, categoryId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'color', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'color', 'description', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == categoryId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.color is string && data.color.size() >= 4 && data.color.size() <= 20
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBook(data, userId, bookId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'author', 'categoryIds', 'isFavorite',
          'status', 'progressPercent', 'currentChapterIndex', 'scrollRatio',
          'totalChapters', 'lastDevice', 'hasCloudChapters', 'isBuiltIn',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'format', 'title', 'author', 'publisher', 'language',
          'synopsis', 'notes', 'coverUrl', 'categoryIds', 'isFavorite',
          'status', 'progressPercent', 'currentChapterIndex', 'scrollRatio',
          'totalChapters', 'lastDevice', 'fileSizeBytes', 'hasCloudChapters',
          'isBuiltIn', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == bookId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && (!('format' in data) || data.format in ['epub', 'pdf'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 140
        && (!('publisher' in data) || (data.publisher is string && data.publisher.size() <= 140))
        && (!('language' in data) || (data.language is string && data.language.size() <= 24))
        && (!('synopsis' in data) || (data.synopsis is string && data.synopsis.size() <= 2000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 120000))
        && data.categoryIds is list && data.categoryIds.size() <= 10
        && (data.categoryIds.size() == 0 || (data.categoryIds[0] is string && data.categoryIds[0].size() <= 128))
        && data.isFavorite is bool
        && data.status in ['unread', 'reading', 'completed']
        && data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.currentChapterIndex is number && data.currentChapterIndex >= 0 && data.currentChapterIndex <= 10000
        && data.scrollRatio is number && data.scrollRatio >= 0 && data.scrollRatio <= 1
        && data.totalChapters is number && data.totalChapters >= 1 && data.totalChapters <= 10000
        && isValidDevice(data.lastDevice)
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 200000000))
        && data.hasCloudChapters is bool
        && data.isBuiltIn is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChapter(data, userId, bookId) {
      return data.keys().hasAll(['ownerId', 'bookId', 'index', 'title', 'htmlContent', 'wordCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'bookId', 'index', 'title', 'htmlContent', 'wordCount', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.bookId is string && data.bookId == bookId && isValidId(data.bookId)
        && data.index is number && data.index >= 0 && data.index <= 10000
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.htmlContent is string && data.htmlContent.size() <= 450000
        && data.wordCount is number && data.wordCount >= 0 && data.wordCount <= 500000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookmark(data, userId, bookmarkId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'bookId', 'chapterIndex', 'chapterTitle',
          'scrollRatio', 'progressPercent', 'deviceName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'bookId', 'chapterIndex', 'chapterTitle',
          'scrollRatio', 'progressPercent', 'excerpt', 'note',
          'deviceName', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == bookmarkId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.bookId is string && isValidId(data.bookId)
        && data.chapterIndex is number && data.chapterIndex >= 0 && data.chapterIndex <= 10000
        && data.chapterTitle is string && data.chapterTitle.size() >= 1 && data.chapterTitle.size() <= 240
        && data.scrollRatio is number && data.scrollRatio >= 0 && data.scrollRatio <= 1
        && data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100
        && (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 600))
        && (!('note' in data) || (data.note is string && data.note.size() <= 1000))
        && isValidDevice(data.deviceName)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Regras de acesso às coleções isoladas por usuário (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerified() && isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastActiveDevice', 'updatedAt']);
      allow delete: if false;

      // 1. Preferências de leitura
      match /preferences/{prefId} {
        allow get: if isOwner(userId) && isValidId(userId) && prefId == 'reader';
        allow list: if false;
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && prefId == 'reader'
          && isValidReaderPreferences(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && prefId == 'reader'
          && isValidReaderPreferences(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'appTheme', 'readerTheme', 'fontFamily', 'fontSize',
            'lineHeight', 'pageWidth', 'textAlign', 'readingMode', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // 2. Categorias personalizadas
      match /categories/{categoryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(categoryId);
        allow list: if isOwner(userId);
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(categoryId)
          && isValidCategory(incoming(), userId, categoryId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(categoryId)
          && isValidCategory(incoming(), userId, categoryId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'description', 'sortOrder', 'updatedAt']);
        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(categoryId);
      }

      // 3. Livros (.epub e .pdf), favoritos e progresso
      match /books/{bookId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookId);
        allow list: if isOwner(userId);
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookId)
          && isValidBook(incoming(), userId, bookId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookId)
          && isValidBook(incoming(), userId, bookId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'author', 'publisher', 'language', 'synopsis', 'notes',
            'coverUrl', 'categoryIds', 'isFavorite', 'status', 'progressPercent',
            'currentChapterIndex', 'scrollRatio', 'lastDevice', 'hasCloudChapters', 'updatedAt'
          ]);
        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookId);

        // 4. Capítulos sincronizados na nuvem
        match /chapters/{chapterId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookId) && isValidId(chapterId)
            && exists(/databases/$(database)/documents/users/$(userId)/books/$(bookId));
          allow list: if isOwner(userId);
          allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookId) && isValidId(chapterId)
            && isValidChapter(incoming(), userId, bookId)
            && exists(/databases/$(database)/documents/users/$(userId)/books/$(bookId))
            && get(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data.ownerId == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time;
          allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookId) && isValidId(chapterId)
            && isValidChapter(incoming(), userId, bookId)
            && exists(/databases/$(database)/documents/users/$(userId)/books/$(bookId))
            && get(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data.ownerId == request.auth.uid
            && incoming().ownerId == existing().ownerId
            && incoming().bookId == existing().bookId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'htmlContent', 'wordCount', 'updatedAt']);
          allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookId) && isValidId(chapterId);
        }
      }

      // 5. Marcadores e anotações
      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookmarkId)
          && isValidBookmark(incoming(), userId, bookmarkId)
          && exists(/databases/$(database)/documents/users/$(userId)/books/$(incoming().bookId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookmarkId)
          && isValidBookmark(incoming(), userId, bookmarkId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'excerpt', 'updatedAt']);
        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
      }
    }
  }
}
