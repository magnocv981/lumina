{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumina",
  "version": "1.0.0",
  "identifier": "com.lumina.epubreader",
  "build": {
    "beforeDevCommand": "bun run dev || npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build || npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumina — Leitor ePub & Biblioteca",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "Livro Digital ePub",
        "description": "Publicação eletrônica ePub",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": ["pdf"],
        "name": "Documento PDF",
        "description": "Livro ou documento em formato PDF",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
